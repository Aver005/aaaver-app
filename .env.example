# --- Сервер ---
PORT=3000

# --- База ---
# Postgres: своя роль и своя база, пароль в URL percent-encoded.
# В докере хост — имя контейнера (`pg`), с хоста — 127.0.0.1.
#
# sslmode=require обязателен: в pg_hba стоит hostssl. Именно require, а не
# verify-full — сертификат выписан на другое имя, а трафик не покидает машину.
#
# Заводится один раз из-под суперпользователя:
#   docker exec -i pg psql -U <superuser> -d <superdb> <<'SQL'
#   CREATE ROLE aaaver LOGIN PASSWORD '...';
#   CREATE DATABASE aaaverdb OWNER aaaver;
#   SQL
#
# Схему накатывает сам сервер при старте (server/db/migrations).
DATABASE_URL=postgres://aaaver:ПАРОЛЬ@pg:5432/aaaverdb?sslmode=require

# --- Telegram ---
# Токен бота: @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# Свой chat_id: напиши боту /start и выполни `bun run chat-id`.
# Если оставить пустым, сервер сам подхватит chat_id из первого /start
# и сохранит его в БД.
TELEGRAM_CHAT_ID=

# --- Анти-спам ---
# Сложность proof-of-work в битах (12-18 разумно, больше = дольше решается у клиента)
POW_DIFFICULTY=14
# Лимит сообщений с одного IP
RATE_LIMIT_PER_HOUR=5
RATE_LIMIT_PER_DAY=20
# Поставь 1, если сервер стоит за nginx/caddy и реальный IP приходит в X-Forwarded-For
TRUST_PROXY=0

# --- deploy.bat (необязательно) ---
# DEPLOY_HOST=
# DEPLOY_USER=root
# DEPLOY_KEY=C:\ssh\key
# DEPLOY_PATH=aaaver-app
# DEPLOY_COMMAND=docker compose up --build -d

# --- Автодеплой демок (необязательно, см. docs/deploy.md) ---
# Токены нужны только для приватных реп или чтобы поднять лимиты API
# GITHUB_TOKEN=
# GITLAB_TOKEN=
# Как часто опрашивать релизы, в минутах
# SITES_POLL_MINUTES=10
# Токен для POST /api/sites-reload (форс-обновление демок).
# Пусто = эндпоинт выключен. Сгенерировать: openssl rand -hex 32
# SITES_RELOAD_TOKEN=

# --- Админка: вход через панель root.kiviuly.ru ---
# Пусто = админка выключена целиком (нужны ОБЕ переменные).
# Как завести клиента в панели — docs/admin.md.
#
# Секрет придумывает панель и показывает один раз, при создании клиента.
SSO_CLIENT_SECRET=
# Кому можно внутрь. Панель ролей в токене не отдаёт: она подтверждает
# личность, а кого пускать — решает этот список. Через запятую.
ADMIN_EMAILS=
# Меняются, только если админка живёт не на aaaver.ru.
# SSO_ISSUER=https://root.kiviuly.ru
# SSO_CLIENT_ID=aaaver-admin
# Адрес возврата. Панель сверяет его ПОСИМВОЛЬНО со своим реестром.
# SSO_REDIRECT_URI=https://aaaver.ru/api/admin/sso/callback
